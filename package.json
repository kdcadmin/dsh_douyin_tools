{
  "name": "dsh-douyin-life",
  "version": "0.2.5",
  "description": "DSH 插件：每天替你刷一轮抖音 —— 看视频读评论挑出值得的、写一份日报，值得的就点赞并在评论里 @ 你；视频那头接你自己的 ComfyUI 出片",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "douyin",
    "comfyui",
    "mcp",
    "duty",
    "automation"
  ],
  "license": "MIT",
  "author": "TiAmoSS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kdcadmin/jev-decision-kit.git",
    "directory": "plugins/dsh-douyin-life"
  },
  "homepage": "https://github.com/kdcadmin/jev-decision-kit/tree/main/plugins/dsh-douyin-life",
  "bugs": {
    "url": "https://github.com/kdcadmin/jev-decision-kit/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/",
    "prompts/",
    "docs/AGENT_ONBOARDING.md",
    "vendor/douyin-mcp/mcp_server.py",
    "vendor/douyin-mcp/requirements.txt",
    "video-understanding-lab/run.py",
    "video-understanding-lab/lab.py",
    "video-understanding-lab/asr.py",
    "video-understanding-lab/media.py",
    "video-understanding-lab/capture.py",
    "video-understanding-lab/evidence.py",
    "video-understanding-lab/replay.py",
    "README.md",
    "SPEC.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "test": "node tests/run.mjs",
    "test:proxy": "node tests/proxy-regression.mjs",
    "test:headless": "node tests/headless-regression.mjs",
    "test:protocol": "node tests/protocol-smoke.mjs",
    "test:media:real": "python tests/real-media-smoke.py"
  }
}
